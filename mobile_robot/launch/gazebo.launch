<?xml version="1.0"?>
<launch>
    
    <param name="robot_description" command="xacro '$(find mobile_robot)/urdf/robot.urdf.xacro'"/>
    <arg name="rviz_config_file" default="$(find mobile_robot)/config/robot.rviz"/>
    

    <env name="GAZEBO_MODEL_PATH" value="${GAZEBO_MODEL_PATH}:$(find warehouse_simulation)/models"/>
    <env name="GAZEBO_RESOURCE_PATH" value="${GAZEBO_RESOURCE_PATH}:$(find warehouse_simulation)/models"/>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find warehouse_simulation)/worlds/warehouse.world"/>
        <arg name="paused" value="false"/>
        <arg name="gui" value="true"/> 
    </include>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
        <param name="publish_frequency" type="double" value="50.0"/>
    </node>

    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config_file)"/>
    <node pkg="gazebo_ros" type="spawn_model" name="spawning_urdf" respawn="false" output="screen"
        args="-urdf -model mark_rover -param robot_description"/>


</launch>